# Kaldor IIoT Analytics Service - Julia Container

FROM julia:1.10-bookworm

WORKDIR /app

# Install system dependencies for LibPQ
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY Project.toml .
COPY src/ src/
COPY main.jl .

# Install Julia dependencies
RUN julia --project=. -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s \
  CMD julia -e 'using HTTP; HTTP.get("http://localhost:5000/health")' || exit 1

# Start application
CMD ["julia", "--project=.", "main.jl"]
